      {
        "component": "post-items",
        "data": {
          "post_type": "project",
          "global_img_path": "src/content/img",
          "exclude_by": [
            {
              "path": "@settings.exclude_from_categories",
              "value": true
            },
            {
              "path": "@settings.render",
              "value": false
            }
          ],
          "template": {
            "component": "card",
            "params": {
              "variant": "post",
              "image": {
                "component": "utility_post_get_img",
                "params": {
                  "root": "@img_base/@data.media.path",
                  "cases": [
                    {
                      "path": "/web/overview/",
                      "img": "web_desktop_overview.webp"
                    },
                    {
                      "path": "/media/overview/",
                      "img": "web_media_overview.webp"
                    },
                    {
                      "path": "/media/",
                      "img": "any",
                      "exclude_path_with_string": "logo",
                      "exclude_img_with_string": "logo"
                    }
                  ]
                }
              },
              "title": "@data.seo.title",
              "description": {
                "component": "utility_text",
                "params": {
                  "input": "@data.seo.description",
                  "outputs": {
                    "limit_chars": 45,
                    "suffix": "..."
                  }
                }
              },
              "date": {
                "component": "utility_date",
                "params": {
                  "input": "@data.date.publish",
                  "format": "dd-mm-yyyy",
                  "outputs": {
                    "display": "d M yyyy",
                    "datetime": "Y-m-d"
                  }
                }
              },
              "taxonomy": {
                "categories": "@data.taxonomy.categories",
                "tags": "@data.taxonomy.tags"
              },
              "button": {
                "component": "button",
                "params": {
                  "text": "View",
                  "svg": "web",
                  "link": {
                    "_id": "@_id"
                  }
                }
              }
            }
          }
        }
      }
    ]
