[
  {
    "_id": "projects",
    "data": {
      "settings": {
        "type": "taxonomy",
        "taxonomy_type": "category",
        "post_types": ["project"],
        "render": true,
        "listing": false
      },
      "seo": {
        "title": "Projects",
        "description": "Showcase of projects I have created or I was involved, featuring designs and functionality of websites and media content.",
        "keywords": "denis marginas projects",
        "slug": "projects",
        "index": false
      },
      "media": {}
    },
    "content": [
      {
        "component": "hero",
        "children": [
          {
            "component": "animation_waves",
            "data": {}
          }
        ],
        "data": {
          "variant": "sm",
          "img": "backgrounds/bg-projects.webp",
          "title": "@data.seo.title",
          "description": "@data.seo.description"
        }
      },
      {
        "component": "section",
        "children": [
          {
            "component": "filters_post_projects",
            "data": {
              "id": "projects",
              "preview_toggle": true,
              "post_type": "project",
              "sort": [
                {
                  "by": "project.types",
                  "value": "personal",
                  "position": "last"
                },
                { "by": "date.publish", "order": "desc" }
              ]
            }
          },
          {
            "component": "post-items",
            "data": {
              "id": "projects",
              "class": "gap-xs gap-sm-sm",
              "post_type": "project",
              "sort": [
                {
                  "by": "project.types",
                  "value": "personal",
                  "position": "last"
                },
                { "by": "date.publish", "order": "desc" }
              ],
              "template": {
                "component": "card_post_project",
                "params": {
                  "visual_component": "card_post_project_visual_default"
                }
              }
            }
          }
        ]
      }
    ]
  },
  {
    "_id": "web-development-projects",
    "data": {
      "settings": {
        "type": "taxonomy",
        "taxonomy_type": "category",
        "post_types": ["project"],
        "render": true,
        "parent": "projects"
      },
      "seo": {
        "title": "Web Development Projects",
        "description": "Showcase of websites and online shops I have created, featuring engaging designs and seamless functionality.",
        "keywords": "denis marginas web development projects",
        "slug": "web-development-projects",
        "index": false
      },
      "media": {
        "svg": "category-web-development",
        "feature_img": "categories/category-photo-web-development-photo.webp"
      }
    },
    "content": [
      {
        "component": "hero",
        "children": [
          {
            "component": "animation_waves",
            "data": {}
          }
        ],
        "data": {
          "variant": "xs",
          "img": "categories/category-photo-web-development-photo.webp",
          "title": "@data.seo.title",
          "description": "@data.seo.description"
        }
      },
      {
        "component": "section",
        "children": [
          {
            "component": "filters_post_projects",
            "data": {
              "id": "projects",
              "post_type": "project",
              "filter_by": { "taxonomy.category": "Web Development Projects" },
              "filters_exclude": ["post-category", "post-media-platform"],
              "exclude_by": [
                { "path": "taxonomy.category", "value": "Miscellaneous Projects" }
              ],
              "sort": { "by": "date.publish", "order": "desc" }
            }
          },
          {
            "component": "post-items",
            "data": {
              "id": "projects",
              "class": "gap-xs gap-sm-sm",
              "post_type": "project",
              "filter_by": {
                "taxonomy.category": "Web Development Projects"
              },
              "exclude_by": [
                { "path": "taxonomy.category", "value": "Miscellaneous Projects" }
              ],
              "sort": { "by": "date.publish", "order": "desc" },
              "template": {
                "component": "card_post_project",
                "params": {
                  "visual_component": "card_post_project_visual_website",
                  "visual_params": {
                    "desktop_device": "model-03",
                    "phone_device": "model-03",
                    "devices_conditions_render": false,
                    "desktop_layout_style": false,
                    "phone_layout_style": false,
                    "screen_path": "web/overview/",
                    "screen_desktop": "web_desktop_overview.webp",
                    "screen_phone": "web_phone_overview.webp"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  },
